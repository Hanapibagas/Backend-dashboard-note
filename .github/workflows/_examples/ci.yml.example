# Example CI workflow for a new service
# Copy this file to .github/workflows/<YOUR_SERVICE_NAME>-ci.yml
# And replace placeholders with your actual values
#
# IMPORTANT: GitHub Actions only detects workflow files placed DIRECTLY in
# .github/workflows/. Do NOT put workflow files in subdirectories — they
# will not be picked up. See:
# https://github.com/orgs/community/discussions/18055

name: CI - <SERVICE_NAME>

on:
  push:
    branches:
      - main
      - develop
    paths:
      - '<SERVICE_PATH>/**'
      - '.github/workflows/<SERVICE_NAME>-ci.yml'
      - '.github/workflows/ci-template.yml'
  pull_request:
    branches:
      - main
      - develop
    paths:
      - '<SERVICE_PATH>/**'
      - '.github/workflows/<SERVICE_NAME>-ci.yml'
      - '.github/workflows/ci-template.yml'

# Required because the ci-template's security job uploads SARIF results
permissions:
  contents: read
  security-events: write

jobs:
  call-ci-workflow:
    uses: ./.github/workflows/ci-template.yml
    with:
      # Replace these values with your service-specific values
      service_name: <SERVICE_NAME>              # e.g., product, user, order
      service_path: <SERVICE_PATH>             # e.g., product, user, order
      go_version: '1.23'                       # Go version (optional, defaults to 1.23)
