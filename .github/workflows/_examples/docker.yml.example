# Example Docker workflow for a new service
# Copy this file to .github/workflows/<YOUR_SERVICE_NAME>-docker.yml
# And replace placeholders with your actual values
#
# IMPORTANT: GitHub Actions only detects workflow files placed DIRECTLY in
# .github/workflows/. Do NOT put workflow files in subdirectories — they
# will not be picked up. See:
# https://github.com/orgs/community/discussions/18055

name: Docker - <SERVICE_NAME>

on:
  push:
    branches:
      - main
      - develop
    paths:
      - '<SERVICE_PATH>/**'
      - '.github/workflows/<SERVICE_NAME>-docker.yml'
      - '.github/workflows/docker-template.yml'
  pull_request:
    branches:
      - main
      - develop
    paths:
      - '<SERVICE_PATH>/**'
      - '.github/workflows/<SERVICE_NAME>-docker.yml'
      - '.github/workflows/docker-template.yml'
  workflow_dispatch:  # Allow manual trigger

# Required because the docker-template's scan job uploads SARIF results
permissions:
  contents: read
  security-events: write
  packages: read

jobs:
  call-docker-workflow:
    uses: ./.github/workflows/docker-template.yml
    secrets:
      docker_hub_username: ${{ secrets.DOCKER_HUB_USERNAME }}
      docker_hub_token: ${{ secrets.DOCKER_HUB_TOKEN }}
    with:
      # Replace these values with your service-specific values
      service_name: <SERVICE_NAME>              # e.g., product, user, order
      service_path: <SERVICE_PATH>             # e.g., product, user, order
      docker_image: <DOCKER_IMAGE_NAME>       # e.g., hanapi/product-service
      docker_platforms: linux/amd64,linux/arm64 # Platforms (optional)
